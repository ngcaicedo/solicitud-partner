{
  "openapi": "3.1.0",
  "info": {
    "title": "Entrada de Solicitudes de Partner",
    "version": "0.1.0"
  },
  "paths": {
    "/solicitudes": {
      "post": {
        "tags": [
          "solicitudes"
        ],
        "summary": "Registrar Solicitud",
        "operationId": "registrar_solicitud_solicitudes_post",
        "parameters": [
          {
            "name": "x-partner-laboratorio",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Identidad seleccionada para la POC local; no autentica al cliente.",
              "title": "X-Partner-Laboratorio"
            },
            "description": "Identidad seleccionada para la POC local; no autentica al cliente."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroSolicitudHTTP"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmacionRegistroSolicitud"
                }
              }
            }
          },
          "409": {
            "description": "Referencia con contenido distinto"
          },
          "422": {
            "description": "Datos invalidos"
          },
          "503": {
            "description": "Persistencia no disponible"
          }
        }
      },
      "get": {
        "tags": [
          "solicitudes"
        ],
        "summary": "Listar Solicitudes",
        "operationId": "listar_solicitudes_solicitudes_get",
        "parameters": [
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limite"
            }
          },
          {
            "name": "desplazamiento",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Desplazamiento"
            }
          },
          {
            "name": "x-partner-laboratorio",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Identidad seleccionada para la POC local; no autentica al cliente.",
              "title": "X-Partner-Laboratorio"
            },
            "description": "Identidad seleccionada para la POC local; no autentica al cliente."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VistaSolicitud"
                  },
                  "title": "Response Listar Solicitudes Solicitudes Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/solicitudes/{id_solicitud}": {
      "get": {
        "tags": [
          "solicitudes"
        ],
        "summary": "Consultar Solicitud",
        "operationId": "consultar_solicitud_solicitudes__id_solicitud__get",
        "parameters": [
          {
            "name": "id_solicitud",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id Solicitud"
            }
          },
          {
            "name": "x-partner-laboratorio",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Identidad seleccionada para la POC local; no autentica al cliente.",
              "title": "X-Partner-Laboratorio"
            },
            "description": "Identidad seleccionada para la POC local; no autentica al cliente."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VistaSolicitud"
                }
              }
            }
          },
          "404": {
            "description": "No disponible en la vista; puede existir retraso de proyeccion"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Liveness Health Live Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
