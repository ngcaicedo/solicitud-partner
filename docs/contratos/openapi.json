      },
      "ConfirmacionRegistroSolicitud": {
        "properties": {
          "id_solicitud": {
            "type": "string",
            "format": "uuid",
            "title": "Id Solicitud"
          },
          "recepcion_confirmada": {
            "type": "boolean",
            "title": "Recepcion Confirmada",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id_solicitud"
        ],
        "title": "ConfirmacionRegistroSolicitud"
      },
      "EstadoSolicitud": {
        "type": "string",
        "enum": [
          "RECIBIDA",
          "LISTA_PARA_ATENCION",
          "RECHAZADA"
        ],
        "title": "EstadoSolicitud"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MotivoRechazo": {
        "type": "string",
        "enum": [
          "APROBACION_PREVIA_REQUERIDA"
        ],
        "title": "MotivoRechazo"
      },
      "RegistroSolicitudHTTP": {
        "properties": {
          "referencia_externa": {
            "type": "string",
            "title": "Referencia Externa"
          },
          "categoria": {
            "type": "string",
            "title": "Categoria"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoSolicitud"
          },
          "aprobacion_previa": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aprobacion Previa"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "referencia_externa",
          "categoria",
          "tipo"
        ],
        "title": "RegistroSolicitudHTTP"
      },
      "TipoRedProveedores": {
        "type": "string",
        "enum": [
          "GENERAL_HDA",
          "HOMOLOGADA_PARTNER"
        ],
        "title": "TipoRedProveedores"
      },
      "TipoSolicitud": {
        "type": "string",
        "enum": [
          "SINIESTRO",
          "INSTALACION"
        ],
        "title": "TipoSolicitud"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VistaSolicitud": {
        "properties": {
          "id_solicitud": {
            "type": "string",
            "format": "uuid",
            "title": "Id Solicitud"
          },
          "id_partner": {
            "type": "string",
            "format": "uuid",
            "title": "Id Partner"
          },
          "referencia_externa": {
            "type": "string",
            "title": "Referencia Externa"
          },
          "categoria": {
            "type": "string",
            "title": "Categoria"
          },
          "tipo_solicitud": {
            "$ref": "#/components/schemas/TipoSolicitud"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoSolicitud"
          },
          "version_solicitud": {
            "type": "integer",
            "title": "Version Solicitud"
          },
          "creada_en": {
            "type": "string",
            "format": "date-time",
            "title": "Creada En"
          },
          "actualizada_en": {
            "type": "string",
            "format": "date-time",
            "title": "Actualizada En"
          },
          "resultado": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Admisibilidad"
              },
              {
                "type": "null"
              }
            ]
          },
          "motivo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MotivoRechazo"
              },
              {
                "type": "null"
              }
            ]
          },
          "tipo_red": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TipoRedProveedores"
              },
              {
                "type": "null"
              }
            ]
          },
          "id_politica": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id Politica"
          },
          "version_politica": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Politica"
          }
        },
        "type": "object",
        "required": [
          "id_solicitud",
          "id_partner",
          "referencia_externa",
          "categoria",
          "tipo_solicitud",
          "estado",
          "version_solicitud",
          "creada_en",
          "actualizada_en"
        ],
        "title": "VistaSolicitud"
      }
    }
  }
}
